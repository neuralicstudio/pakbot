# BISP Helpline (Pipecat) - Environment Variables
# Copy this file to .env and fill in your API keys

# Speechmatics (STT - Urdu)
SPEECHMATICS_API_KEY=

# OpenAI (STT gpt-4o-transcribe for English / LLM gpt-4o)
OPENAI_API_KEY=

# Fish Audio (TTS - Urdu primary)
FISH_AUDIO_API_KEY=

# Cartesia (TTS - fallback for Urdu, primary for English)
CARTESIA_API_KEY=
# Optional override for the English voice; a default is baked into bot.py.
CARTESIA_VOICE_ID=

# ICE servers for WebRTC (required on Render and any HTTP-proxy-only host).
# JSON array of RTCIceServer objects. Must include a TURN server with TCP/TLS
# support so media can relay through Render's HTTP-only infrastructure.
# Example: [{"urls":"turns:your-turn-host:5349","username":"u","credential":"p"}]
# Leave blank for local development (direct UDP works on localhost).
PIPECAT_ICE_SERVERS=
